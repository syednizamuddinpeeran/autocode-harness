# ─────────────────────────────────────────────────────────────────────────────
# The ONE file you edit per project. Everything else in the template is generic.
# Agents read this file but cannot modify it (enforced by the preToolUse guard).
# Leave a command empty ("") to skip that check.
# ─────────────────────────────────────────────────────────────────────────────

BASE_BRANCH="main"

# Installs dependencies. Runs in the cloud agent setup job, CI, before local runs and in accept.sh.
SETUP_CMD=""

# Verification gate, run in this order by scripts/factory/check.sh (and by CI / accept.sh).
FORMAT_CHECK_CMD=""
LINT_CMD="git ls-files -z '*.sh' | xargs -0 shellcheck --severity=warning --shell=bash"
TYPECHECK_CMD=""
TEST_CMD="bash tests/repo-harness.sh && bash tests/launcher-flow.sh && bash tests/check-assistant-sync.sh && bash tests/check-links.sh"
BUILD_CMD=""

# Set to 1 only for repos with genuinely nothing to check (e.g. docs-only).
ALLOW_NO_CHECKS=0

# ── Presets: copy one block over the values above ──────────────────────────
# Python (uv):
#   SETUP_CMD="uv sync --all-extras"
#   FORMAT_CHECK_CMD="uv run ruff format --check ."
#   LINT_CMD="uv run ruff check ."
#   TYPECHECK_CMD="uv run mypy ."
#   TEST_CMD="uv run pytest -q"
#   BUILD_CMD=""
#
# TypeScript (npm):
#   SETUP_CMD="npm ci"
#   FORMAT_CHECK_CMD="npx prettier --check ."
#   LINT_CMD="npm run lint"
#   TYPECHECK_CMD="npx tsc --noEmit"
#   TEST_CMD="npm test -- --run"
#   BUILD_CMD="npm run build"
#
# Java (Gradle):
#   SETUP_CMD="./gradlew dependencies --quiet"
#   LINT_CMD="./gradlew spotlessCheck"
#   TEST_CMD="./gradlew test"
#   BUILD_CMD="./gradlew build -x test"
#
# .NET:
#   SETUP_CMD="dotnet restore"
#   FORMAT_CHECK_CMD="dotnet format --verify-no-changes"
#   TEST_CMD="dotnet test --no-restore"
#   BUILD_CMD="dotnet build --no-restore"
#
# AWS CDK app (synth only — agents never deploy):
#   BUILD_CMD="npx cdk synth --quiet"

# Coding assistant this repo was installed for (install.sh --assistant). Read by run-issue/run-task.
ASSISTANT="claude-code"
