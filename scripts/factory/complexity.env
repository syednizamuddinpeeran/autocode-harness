# ─────────────────────────────────────────────────────────────────────────────
# When is an issue / task too big for one factory run? Edit to suit the project.
# After planning, scripts/factory/check-complexity.sh measures the plan and the brief against
# these limits. If any limit is exceeded, no code is written: the planner proposes a breakdown
# into smaller items instead, and a human creates them (create-issues / create-tasks).
# Agents cannot modify this file (it is write-protected by the guard).
# ─────────────────────────────────────────────────────────────────────────────

# Acceptance criteria in the brief.
MAX_ACCEPTANCE_CRITERIA=5
# Tasks (### T<n>) in the plan; each task is one commit.
MAX_PLAN_TASKS=6
# Distinct files the plan touches (Files: and Tests: lines).
MAX_FILES=15
# The planner's estimate of lines added + removed.
MAX_EST_LINES=400

# Areas: space-separated name=path-prefix pairs, e.g. "web=web/ android=android/ api=services/api/".
# A plan touching more than MAX_AREAS areas is split per area. Files outside every area (tests,
# docs, shared config) are not counted. Empty = area check off.
AREAS=""
MAX_AREAS=1

# Risk levels that must be split down to single-task items (space-separated; empty = never).
SPLIT_ON_RISK="high"

# Most items a breakdown may propose.
MAX_SUBITEMS=8
# run-batch: most items run at the same time.
MAX_PARALLEL=3
